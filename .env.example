# Required
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# Optional: set this to register commands instantly in one server while testing.
GUILD_ID=

# Groq AI support
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true

# PringleSMP server details
SERVER_NAME=PringleSMP
MC_IP=pringlesmp.mcsh.io
MC_PORT=19132
DISCORD_INVITE=https://discord.gg/5BSSkFeNfR

# Existing Discord IDs. /setup can create these for you.
STAFF_ROLE_ID=
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=

# Ticket behavior
INACTIVITY_MINUTES=5

# Render / web health endpoint
PORT=10000